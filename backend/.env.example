
# Application
APP_NAME=Pigeon
DEBUG=true

# Database — use SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./chess_archive.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chess_archive

# OCR
OCR_PROVIDER=mock

# File storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
