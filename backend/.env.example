# Application
APP_NAME=Pigeon
DEBUG=true

# Database — use SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./chess_archive.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chess_archive

# OCR — use mock for CI/tests; use tesseract locally after installing the binary
OCR_PROVIDER=mock
# OCR_PROVIDER=tesseract

# File storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10

# CORS — comma-separated origins for the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
